        "# ── TODO 6b: Perplexity ──────────────────────────────────────────────────────\n",
        "# SCORING: 5 points\n",
        "# Perplexity measures how \"surprised\" the model is by a test sentence.\n",
        "# Lower is better. PP = 1 means perfect certainty.\n",
        "#\n",
        "# Formula (using log-probabilities to avoid underflow):\n",
        "#   log_prob = sum of log( smoothed_prob(w_i | w_{i-1}) ) for each bigram\n",
        "#   perplexity = exp( -log_prob / N )   where N = number of tokens\n",
        "\n",
        "def sentence_perplexity(sentence, bigram_counts, unigram_counts, vocab_size):\n",
        "    \"\"\"\n",
        "    Compute bigram perplexity of a sentence (already pre-processed string).\n",
        "    Returns float. Use math.log() and math.exp().\n",
        "    \"\"\"\n",
        "    tokens = sentence.split()\n",
        "    if len(tokens) < 2:\n",
