      "id": "6dc09b13",
      "cell_type": "code",
      "source": [
        "# ── Challenge 3: Custom Feature Engineering ──────────────────────────────────\n",
        "from scipy.sparse import hstack, csr_matrix\n",
        "from sklearn.metrics import f1_score\n",
        "\n",
        "def extract_custom_features(texts_clean, texts_raw):\n",
        "    \"\"\"\n",
        "    Returns a dense numpy array of shape (n_samples, 4).\n",
        "    texts_clean: pre-processed strings (from df['cleaned'])\n",
        "    texts_raw:   original reviews (from df['review'])\n",
        "    \"\"\"\n",
        "    features = []\n",
        "    for clean, raw in zip(texts_clean, texts_raw):\n",
        "        tokens = clean.split()\n",
        "        # TODO: Feature 1 — word count (raw integer — normalise later)\n",
        "        f1 = len(tokens)\n",
        "\n",
        "        # TODO: Feature 2 — exclamation mark count in the original review\n",
        "        f2 = raw.count('!')\n",
        "\n",
        "        # TODO: Feature 3 — ALL-CAPS word count in original review\n",
        "        f3 = sum(1 for t in raw.split() if t.isupper() and len(t) > 1)\n",
        "\n",
        "        # TODO: Feature 4 — average word length in cleaned review\n",
        "        f4 = sum(len(t) for t in tokens) / len(tokens) if len(tokens) > 0 else 0.0\n",
        "\n",
        "        features.append([f1, f2, f3, f4])\n",
        "\n",
        "    features_array = np.array(features, dtype=float)\n",
        "    # Normalise each feature column to [0, 1]\n",
        "    col_max = features_array.max(axis=0)\n",
        "    col_max[col_max == 0] = 1  # avoid divide-by-zero\n",
        "    features_array = features_array / col_max\n",
        "    return features_array\n",
        "\n",
        "\n",
        "# ── Extract features for train and test ───────────────────────────────────────\n",
        "# Align raw reviews with the split indices\n",
        "train_raw = df.loc[X_train.index, 'review']\n",
        "test_raw  = df.loc[X_test.index, 'review']\n",
