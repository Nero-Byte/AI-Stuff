        "            total_in_c = self.class_token_totals[c]\n",
        "\n",
        "            for token in tokens:\n",
        "                score += self.log_likelihoods[c].get(\n",
        "                    token,\n",
        "                    math.log(1 / (total_in_c + self.vocab_size))\n",
        "                )\n",
        "\n",
        "            scores[c] = score\n",
        "        # TODO: return the class with the maximum score\n",
        "        return max(scores, key=scores.get)\n",
        "\n",
        "    def predict(self, texts):\n",
