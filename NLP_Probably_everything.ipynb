        "# TODO C3a: Call extract_custom_features for train and test sets\n",
        "train_custom = extract_custom_features(df.loc[X_train.index, 'cleaned'], train_raw)\n",
        "test_custom  = extract_custom_features(df.loc[X_test.index, 'cleaned'], test_raw)\n",
        "\n",
        "# TODO C3b: Convert to sparse matrix with csr_matrix() and\n",
        "#            concatenate with X_train_tfidf using hstack()\n",
        "X_train_augmented = hstack([X_train_tfidf, csr_matrix(train_custom)])\n",
        "X_test_augmented  = hstack([X_test_tfidf, csr_matrix(test_custom)])\n",
